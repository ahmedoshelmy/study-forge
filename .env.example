# Copy to .env to override the compose defaults. Placeholder values only.
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=change-me
# Port of the web UI on the host.
WEB_PORT=8095
# insights-service retry topics: attempts before the DLT and the first back-off delay.
INSIGHTS_RETRY_ATTEMPTS=4
INSIGHTS_RETRY_DELAY_MS=1000
# OpenTelemetry export, off by default.
TRACING_SAMPLING=0.0
OTLP_ENABLED=false
